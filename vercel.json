{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/foundations", "destination": "/foundations" },
    { "source": "/systems", "destination": "/systems" },
    { "source": "/skills", "destination": "/skills" },
    { "source": "/tools", "destination": "/tools" },
    { "source": "/comparisons", "destination": "/comparisons" },
    { "source": "/case-studies", "destination": "/case-studies" }
  ]
}
